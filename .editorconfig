# One formatting truth for every editor and for CI (Spotless/ktlint for Kotlin, Ruff for Python).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 140
ktlint_code_style = intellij_idea
# Compose functions are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Short `a; b` statements and one-line `when` arms are used on purpose for dense, readable logic.
ktlint_standard_statement-wrapping = disabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_function-signature = disabled
ktlint_standard_class-signature = disabled
ktlint_standard_chain-method-continuation = disabled
ktlint_standard_string-template-indent = disabled
ktlint_standard_backing-property-naming = disabled
ktlint_standard_filename = disabled

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
