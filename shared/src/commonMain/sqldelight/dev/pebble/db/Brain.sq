-- Labels you give the command model (active learning). Local only; exported by brain/feedback.py
-- when you choose to retrain. outcome: picked ("Did you mean…?" choice), confirmed (model acted, no
-- objection) or wrong ("Not what I meant": chosen_action is what Pebble wrongly did).
CREATE TABLE command_feedback (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    text TEXT NOT NULL,
    chosen_action TEXT NOT NULL,
    model_intent TEXT,
    model_confidence REAL,
    at_millis INTEGER NOT NULL,
    outcome TEXT NOT NULL DEFAULT 'picked'
);

-- The nudge policy's beliefs (NudgePolicy): Beta(alpha, beta) per "context|arm". Local, resettable.
CREATE TABLE nudge_stats (
    key TEXT NOT NULL PRIMARY KEY,
    alpha REAL NOT NULL,
    beta REAL NOT NULL
);

allNudgeStats:
SELECT * FROM nudge_stats;

saveNudgeStat:
INSERT OR REPLACE INTO nudge_stats(key, alpha, beta) VALUES (?, ?, ?);

clearNudgeStats:
DELETE FROM nudge_stats;

-- Voice clips you corrected, opt-in (settings "voice.keepCorrections"): the audio file lives in
-- %APPDATA%\Pebble\voice\, the row says what Whisper heard and what you meant. Deletable on the Memory page.
CREATE TABLE voice_sample (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    wav_path TEXT NOT NULL,
    asr_text TEXT NOT NULL,
    final_text TEXT NOT NULL,
    asr_model TEXT NOT NULL,
    at_millis INTEGER NOT NULL
);

insertVoiceSample:
INSERT INTO voice_sample(wav_path, asr_text, final_text, asr_model, at_millis) VALUES (?, ?, ?, ?, ?);

allVoiceSamples:
SELECT * FROM voice_sample ORDER BY at_millis;

voiceSampleCount:
SELECT count(*) FROM voice_sample;

deleteVoiceSamples:
DELETE FROM voice_sample;

-- Your conversation with Pebble: what you said (typed or voice), what Pebble did, what it replied.
-- Local only; the Chat page shows it and can clear it.
CREATE TABLE conversation_turn (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    at_millis INTEGER NOT NULL,
    said TEXT NOT NULL,
    via TEXT NOT NULL,
    did TEXT NOT NULL,
    reply TEXT NOT NULL
);

insertTurn:
INSERT INTO conversation_turn(at_millis, said, via, did, reply) VALUES (?, ?, ?, ?, ?);

recentTurns:
SELECT * FROM conversation_turn WHERE id > (SELECT coalesce(max(id), 0) FROM conversation_turn) - ? ORDER BY id;

turnCount:
SELECT count(*) FROM conversation_turn;

clearTurns:
DELETE FROM conversation_turn;

insertFeedback:
INSERT INTO command_feedback(text, chosen_action, model_intent, model_confidence, at_millis, outcome) VALUES (?, ?, ?, ?, ?, ?);

lastFeedbackId:
SELECT last_insert_rowid();

setOutcome:
UPDATE command_feedback SET outcome = ? WHERE id = ?;

allFeedback:
SELECT * FROM command_feedback ORDER BY at_millis;

feedbackCount:
SELECT count(*) FROM command_feedback;
