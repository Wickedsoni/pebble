CREATE TABLE reminder_rule (
    id TEXT NOT NULL PRIMARY KEY,
    kind TEXT NOT NULL,
    title TEXT NOT NULL,
    interval_minutes INTEGER NOT NULL,
    strictness TEXT NOT NULL,
    enabled INTEGER NOT NULL DEFAULT 1,
    active_from_minute INTEGER NOT NULL DEFAULT 480,
    active_to_minute INTEGER NOT NULL DEFAULT 1380,
    last_done_at INTEGER
);

CREATE TABLE one_off_reminder (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    due_at INTEGER NOT NULL,
    strictness TEXT NOT NULL,
    done_at INTEGER,
    -- Sync-ready (WP E1, 11.sqm): see 11.sqm for each column.
    uid TEXT,
    updated_at INTEGER,
    deleted_at INTEGER,
    hlc TEXT,
    origin_device TEXT,
    -- A reminder that a calendar event made (WP E2, 12.sqm): the event's uid and the occurrence's start.
    event_uid TEXT,
    occurrence_at INTEGER
);

CREATE UNIQUE INDEX one_off_reminder_uid ON one_off_reminder(uid);

CREATE INDEX one_off_reminder_event ON one_off_reminder(event_uid, occurrence_at);

allRules:
SELECT * FROM reminder_rule ORDER BY id;

insertRuleIfMissing:
INSERT OR IGNORE INTO reminder_rule(id, kind, title, interval_minutes, strictness, enabled)
VALUES (?, ?, ?, ?, ?, ?);

updateRuleSettings:
UPDATE reminder_rule SET interval_minutes = ?, strictness = ?, enabled = ? WHERE id = ?;

markRuleDone:
UPDATE reminder_rule SET last_done_at = ? WHERE id = ?;

pendingOneOffs:
SELECT * FROM one_off_reminder WHERE done_at IS NULL AND deleted_at IS NULL ORDER BY due_at;

-- Writes to synced fields carry the HLC of their journal entries (WP E3, ChangeJournal). A null :hlc keeps the
-- row's HLC: for rows that are not synced (a reminder that an event made, or no uid yet).
insertOneOff:
INSERT INTO one_off_reminder(title, due_at, strictness, uid, updated_at, hlc, origin_device)
VALUES (:title, :dueAt, :strictness, :uid, :at, :hlc, (SELECT value FROM setting WHERE key = 'device.id'));

lastOneOffId:
SELECT last_insert_rowid();

-- A tombstone, not a DELETE (WP E1). Null time: now.
deleteOneOff:
UPDATE one_off_reminder SET deleted_at = :at, updated_at = :at, hlc = coalesce(:hlc, hlc) WHERE id = :id;

purgeOneOffTombstones:
DELETE FROM one_off_reminder WHERE deleted_at IS NOT NULL AND deleted_at < ?;

claimOneOffs:
UPDATE one_off_reminder SET origin_device = ? WHERE origin_device IS NULL;

fillOneOffUids:
UPDATE one_off_reminder SET uid = lower(hex(randomblob(16))), updated_at = coalesce(updated_at, done_at, due_at) WHERE uid IS NULL;

markOneOffDone:
UPDATE one_off_reminder SET done_at = :at, updated_at = :at, hlc = coalesce(:hlc, hlc) WHERE id = :id;

rescheduleOneOff:
UPDATE one_off_reminder SET due_at = :dueAt, updated_at = :at, hlc = coalesce(:hlc, hlc) WHERE id = :id;

-- What sync needs to know of a reminder: its uid (null: not synced yet) and its event (non-null: not synced).
oneOffSyncInfo:
SELECT uid, event_uid FROM one_off_reminder WHERE id = ?;

-- The synced fields of each synced reminder, live and tombstones (ChangeJournal.reconcile).
syncOneOffs:
SELECT uid, title, due_at, strictness, done_at, deleted_at, hlc FROM one_off_reminder WHERE uid IS NOT NULL AND event_uid IS NULL;

setOneOffHlc:
UPDATE one_off_reminder SET hlc = ? WHERE uid = ?;

insertLinkedOneOff:
INSERT INTO one_off_reminder(title, due_at, strictness, uid, updated_at, origin_device, event_uid, occurrence_at)
VALUES (?, ?, ?, lower(hex(randomblob(16))), ?, (SELECT value FROM setting WHERE key = 'device.id'), ?, ?);

-- Done, pending or skipped: any live row means this occurrence already had its reminder.
linkedOneOffExists:
SELECT count(*) FROM one_off_reminder WHERE event_uid = ? AND occurrence_at = ? AND deleted_at IS NULL;

-- The event was deleted (a tombstone): it gets no new reminder. Checked in addLinked's transaction, because the
-- 10-minute loop can read the event just before a delete on another thread.
linkedEventDeleted:
SELECT count(*) FROM calendar_event WHERE uid = ? AND deleted_at IS NOT NULL;

-- The event changed or was deleted: its reminders that did not fire yet go (tombstones).
deletePendingLinked:
UPDATE one_off_reminder SET deleted_at = :at, updated_at = :at WHERE event_uid = :eventUid AND done_at IS NULL AND deleted_at IS NULL;

-- The merge (WP E3b, ChangeJournal.apply); reminders that an event made are never merged.
syncOneOffByUid:
SELECT uid, title, due_at, strictness, done_at, deleted_at, hlc, updated_at, event_uid FROM one_off_reminder WHERE uid = ?;

mergeInsertOneOff:
INSERT INTO one_off_reminder(uid, title, due_at, strictness, done_at, deleted_at, updated_at, origin_device, hlc)
VALUES (:uid, :title, :dueAt, :strictness, :doneAt, :deletedAt, :updatedAt, :originDevice, NULL);

mergeUpdateOneOff:
UPDATE one_off_reminder SET title = :title, due_at = :dueAt, strictness = :strictness, done_at = :doneAt, deleted_at = :deletedAt,
    updated_at = max(coalesce(updated_at, 0), :updatedAt), hlc = :hlc
WHERE uid = :uid AND event_uid IS NULL;
