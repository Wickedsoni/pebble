-- WP C2: sentence embeddings of what you wrote and said, for memory search.
-- vec: float32, little-endian. model_version: the command model that made it (re-embedded when it changes).
-- text: what was embedded, so an edited note is embedded again.

CREATE TABLE vector_item (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    kind TEXT NOT NULL,
    ref_id TEXT NOT NULL,
    text TEXT NOT NULL,
    vec BLOB NOT NULL,
    model_version TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE UNIQUE INDEX vector_item_ref ON vector_item(kind, ref_id);
