-- History of synced fields (WP E3c, ADR 0019, docs/specs/E3C-HISTORY.md): old values that a newer change replaced,
-- and edits of other devices that lost a merge. It stays on this device: sync never sends it.
-- [value] is JSON, as in change_journal. [hlc]: the HLC of this old value. [replaced_by]: the HLC of the change that
-- replaced it (null for a lost edit). [kept_at]: when it was kept (local time, for the 90-day purge).
CREATE TABLE change_history (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    tbl TEXT NOT NULL,
    uid TEXT NOT NULL,
    field TEXT NOT NULL,
    value TEXT NOT NULL,
    hlc TEXT NOT NULL,
    replaced_by TEXT,
    kept_at INTEGER NOT NULL,
    kind TEXT NOT NULL CHECK (kind IN ('replaced', 'lost')),
    UNIQUE (tbl, uid, field, hlc)
);

CREATE INDEX change_history_row ON change_history(tbl, uid);
CREATE INDEX change_history_kept ON change_history(kept_at);

-- Keeps the entry that a new journal entry replaces, on every path (record, merge, reconcile). A journal entry is
-- replaced with INSERT OR REPLACE, which fires BEFORE INSERT (checked with sqlite-jdbc 3.53.4.0). A delete is final,
-- so deleted_at is not kept. The same entry again (the same HLC) keeps nothing.
CREATE TRIGGER change_journal_keep_history BEFORE INSERT ON change_journal
BEGIN
    INSERT OR IGNORE INTO change_history(tbl, uid, field, value, hlc, replaced_by, kept_at, kind)
    SELECT tbl, uid, field, value, hlc, new.hlc, CAST(strftime('%s', 'now') AS INTEGER) * 1000, 'replaced'
    FROM change_journal
    WHERE tbl = new.tbl AND uid = new.uid AND field = new.field AND hlc <> new.hlc AND field <> 'deleted_at';
END;

-- A peer's edit that lost the merge (ChangeJournal.apply).
keepLost:
INSERT OR IGNORE INTO change_history(tbl, uid, field, value, hlc, replaced_by, kept_at, kind)
VALUES (?, ?, ?, ?, ?, NULL, ?, 'lost');

historyOfRow:
SELECT field, value, hlc, replaced_by, kind FROM change_history WHERE tbl = ? AND uid = ?;

-- The lost edits kept since a time: one for each (row, HLC).
lostSince:
SELECT count(*) FROM (SELECT DISTINCT tbl, uid, hlc FROM change_history WHERE kind = 'lost' AND kept_at >= ?);

clearHistory:
DELETE FROM change_history;

purgeHistoryBefore:
DELETE FROM change_history WHERE kept_at < ?;

-- The history of rows that are gone (a purged tombstone): the text of a deleted item leaves with its row.
purgeHistoryOfGoneRows:
DELETE FROM change_history WHERE
    (tbl = 'note' AND uid NOT IN (SELECT uid FROM note WHERE uid IS NOT NULL))
    OR (tbl = 'one_off_reminder' AND uid NOT IN (SELECT uid FROM one_off_reminder WHERE uid IS NOT NULL AND event_uid IS NULL))
    OR (tbl = 'calendar_event' AND uid NOT IN (SELECT uid FROM calendar_event));

-- Tombstones deleted at or after a time, for "Recently deleted". Calendar-made reminders are not synced, so not listed.
deletedNotesSince:
SELECT uid, text, deleted_at FROM note WHERE uid IS NOT NULL AND deleted_at IS NOT NULL AND deleted_at >= ?;

deletedRemindersSince:
SELECT uid, title, deleted_at FROM one_off_reminder
WHERE uid IS NOT NULL AND event_uid IS NULL AND deleted_at IS NOT NULL AND deleted_at >= ?;

deletedEventsSince:
SELECT uid, title, deleted_at FROM calendar_event WHERE deleted_at IS NOT NULL AND deleted_at >= ?;
