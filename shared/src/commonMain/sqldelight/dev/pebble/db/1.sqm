-- Phase 1: reminders, water tracking and notes.

CREATE TABLE reminder_rule (
    id TEXT NOT NULL PRIMARY KEY,
    kind TEXT NOT NULL,
    title TEXT NOT NULL,
    interval_minutes INTEGER NOT NULL,
    strictness TEXT NOT NULL,
    enabled INTEGER NOT NULL DEFAULT 1,
    active_from_minute INTEGER NOT NULL DEFAULT 480,
    active_to_minute INTEGER NOT NULL DEFAULT 1380,
    last_done_at INTEGER
);

CREATE TABLE one_off_reminder (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    due_at INTEGER NOT NULL,
    strictness TEXT NOT NULL,
    done_at INTEGER
);

CREATE TABLE water_log (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    at_millis INTEGER NOT NULL,
    ml INTEGER NOT NULL
);

CREATE INDEX water_log_at ON water_log(at_millis);

CREATE TABLE note (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    text TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    archived INTEGER NOT NULL DEFAULT 0
);
