CREATE TABLE water_log (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    at_millis INTEGER NOT NULL,
    ml INTEGER NOT NULL
);

CREATE INDEX water_log_at ON water_log(at_millis);

CREATE TABLE note (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    text TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    archived INTEGER NOT NULL DEFAULT 0,
    -- Sync-ready (WP E1, 11.sqm): see 11.sqm for each column.
    uid TEXT,
    deleted_at INTEGER,
    hlc TEXT,
    origin_device TEXT
);


CREATE UNIQUE INDEX note_uid ON note(uid);

logWater:
INSERT INTO water_log(at_millis, ml) VALUES (?, ?);

waterSince:
SELECT coalesce(sum(ml), 0) FROM water_log WHERE at_millis >= ?;

undoLastWaterSince:
DELETE FROM water_log WHERE id = (SELECT max(id) FROM water_log WHERE at_millis >= ?);

-- Writes to synced fields carry the HLC of their journal entries (WP E3, ChangeJournal). A null :hlc keeps the
-- row's HLC: only for rows that are not synced yet (no uid); ChangeJournal.reconcile records them later.
insertNote:
INSERT INTO note(text, created_at, updated_at, uid, hlc, origin_device)
VALUES (:text, :createdAt, :updatedAt, :uid, :hlc, (SELECT value FROM setting WHERE key = 'device.id'));

lastInsertedId:
SELECT last_insert_rowid();

updateNote:
UPDATE note SET text = :text, updated_at = :at, hlc = coalesce(:hlc, hlc) WHERE id = :id;

-- A tombstone, not a DELETE: other devices must learn about the delete (WP E1). Null time: now.
deleteNote:
UPDATE note SET deleted_at = :at, updated_at = :at, hlc = coalesce(:hlc, hlc) WHERE id = :id;

-- Tombstones older than the time given (90 days until sync can confirm that every peer has seen them).
purgeNoteTombstones:
DELETE FROM note WHERE deleted_at IS NOT NULL AND deleted_at < ?;

-- Rows made before this device had an id, or by an older Pebble that has no uid: they are this device's.
claimNotes:
UPDATE note SET origin_device = ? WHERE origin_device IS NULL;

fillNoteUids:
UPDATE note SET uid = lower(hex(randomblob(16))) WHERE uid IS NULL;

archiveNote:
UPDATE note SET archived = 1, updated_at = :at, hlc = coalesce(:hlc, hlc) WHERE id = :id;

-- The uid of a note, for its journal entries (null: an older Pebble made it and it has no uid yet).
noteUid:
SELECT uid FROM note WHERE id = ?;

-- The synced fields of each synced note, live and tombstones (ChangeJournal.reconcile).
syncNotes:
SELECT uid, text, created_at, archived, deleted_at, hlc FROM note WHERE uid IS NOT NULL;

setNoteHlc:
UPDATE note SET hlc = ? WHERE uid = ?;

activeNotes:
SELECT * FROM note WHERE archived = 0 AND deleted_at IS NULL ORDER BY updated_at DESC LIMIT ?;

waterLogSince:
SELECT at_millis, ml FROM water_log WHERE at_millis >= ? ORDER BY at_millis;

-- The merge (WP E3b, ChangeJournal.apply). A new row starts with no hlc; the merge sets it after the journal entries.
-- An update writes all synced fields, with the hlc of the fields that changed in this step.
syncNoteByUid:
SELECT uid, text, created_at, archived, deleted_at, hlc, updated_at FROM note WHERE uid = ?;

mergeInsertNote:
INSERT INTO note(uid, text, created_at, archived, deleted_at, updated_at, origin_device, hlc)
VALUES (:uid, :text, :createdAt, :archived, :deletedAt, :updatedAt, :originDevice, NULL);

mergeUpdateNote:
UPDATE note SET text = :text, created_at = :createdAt, archived = :archived, deleted_at = :deletedAt,
    updated_at = max(updated_at, :updatedAt), hlc = :hlc
WHERE uid = :uid;
